# =====================================================================
# MediPrice Pro — Backend Environment Configuration Template
# =====================================================================

# --- Supabase / Cloud PostgreSQL Database Connection ---
# Option 1: Direct Connection URL (Recommended for Supabase)
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Option 2: Individual Connection Parameters (Local or Custom DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_pricing
DB_USER=postgres
DB_PASSWORD=root

# --- AI Provider Configuration ---
GROQ_API_KEY_1=your_first_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY_1=your_first_openrouter_api_key_here
OPENROUTER_API_KEY_2=your_second_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# --- Production Security & CORS ---
ALLOWED_ORIGINS=https://your-production-domain.com,http://localhost:3000

